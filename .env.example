# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla paylaşılmamalı.
# Yeni gizli anahtarlar üretmek için: python scripts/setup_env.py

# Sitenin dışarıdan görünen adresi. Alan adı alınca: https://alanadiniz.com
BASE_URL=https://localhost:8080

# Oturum çerezlerini imzalar. Uzun, rastgele bir metin.
SECRET_KEY=

# Yahoo tokenlarını veritabanında şifrelemek için uzun, rastgele bir metin.
# Değiştirilirse kayıtlı tokenlar okunamaz, kullanıcılar yeniden bağlanır.
TOKEN_ENCRYPTION_KEY=

# Varsayılan SQLite. Sunucuda örn. postgresql+psycopg://kullanici:sifre@host/db
DATABASE_URL=sqlite:///./data/app.db

# developer.yahoo.com/apps altındaki uygulamanızdan
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Yahoo uygulamasına Redirect URI olarak BASE_URL + bu yol eklenmeli
YAHOO_CALLBACK_PATH=/auth/callback
# Boş bırakılırsa uygulamada tanımlı izinlerin hepsi istenir.
# Uygulamada OpenID izni varsa: openid fspt-r
YAHOO_SCOPE=

# true: "Demo ile dene" düğmesi açık, Yahoo'suz örnek veriyle çalışır
DEMO_MODE=true

# Yahoo cevaplarının önbellekte kalma süresi (saniye)
CACHE_TTL_SECONDS=600

# true: Yahoo'dan gelen ham cevaplar fixtures/ klasörüne kaydedilir
RECORD_FIXTURES=false
